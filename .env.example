# 数据文件位置（默认 ./data/roundtable.db）
# ROUNDTABLE_DB_PATH=./data/roundtable.db

# 可选：首次初始化时自动创建这些 Provider（也可以在页面里手动配置）
# 国产模型优先：DeepSeek / 通义千问 / 腾讯混元 Hy4 / 小米 MiMo / 智谱 GLM
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=         # 阿里云百炼（通义千问）
# DASHSCOPE_BASE_URL=        # 可选：业务空间专属地址，默认兼容模式地址
# TOKENHUB_API_KEY=          # 腾讯云 TokenHub，用于 hy4 / hy4-flash
# MIMO_API_KEY=              # 小米 MiMo：tp-/ttp- 走 Token Plan，sk- 走按量付费
# MIMO_BASE_URL=            # 可选：Token Plan 控制台给出的专属 Base URL
# ZHIPU_API_KEY=             # 智谱开放平台（GLM）
# MOONSHOT_API_KEY=          # Kimi / 月之暗面（K3.1 Pro）
# MOONSHOT_BASE_URL=         # 可选，默认 https://api.moonshot.cn/v1

# 其他厂商
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# 可选：自定义 OpenAI 兼容网关
# OPENAI_BASE_URL=https://api.openai.com/v1
